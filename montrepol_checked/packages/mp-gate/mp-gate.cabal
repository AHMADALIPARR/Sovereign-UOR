name:               mp-gate
version:            0.1.0.0
synopsis:           The repository gate: rules R1 to R6 over the model, the sources and the build.
license:            AGPL-3.0-or-later
build-type:         Simple

library
  exposed-modules:  MP.Gate.Toml
                    MP.Gate.Model
                    MP.Gate.Scan
                    MP.Gate.Rules
                    MP.Gate.Render
  hs-source-dirs:   src
  build-depends:    base >=4.20 && <4.21
  default-language: GHC2021

executable mp-gate
  main-is:          Main.hs
  other-modules:    Mutants
  hs-source-dirs:   app
  build-depends:    base >=4.20 && <4.21, directory >=1.3 && <1.4, filepath >=1.5 && <1.6, process >=1.6 && <1.7, mp-gate
  default-language: GHC2021

test-suite mp-gate-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base >=4.20 && <4.21, mp-check, mp-gate
  default-language: GHC2021
