cabal-version:      3.0
-- SPDX-License-Identifier: AGPL-3.0-or-later
name:               mp-lambda
version:            0.1.0.0
synopsis:           The simply typed lambda calculus, and refinement types checked by Hcalc.
license:            AGPL-3.0-or-later
build-type:         Simple

library
  exposed-modules:  MP.Lambda.Simple
                    MP.Lambda.Refine
  hs-source-dirs:   src
  build-depends:    base >=4.20 && <4.21, containers >=0.7 && <0.8, mp-hcalc
  default-language: GHC2021

test-suite mp-lambda-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base >=4.20 && <4.21, containers >=0.7 && <0.8, mp-check, mp-hcalc, mp-lambda
  default-language: GHC2021
