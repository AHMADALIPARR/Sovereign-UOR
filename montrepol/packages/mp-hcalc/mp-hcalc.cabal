cabal-version:      3.0
-- SPDX-License-Identifier: AGPL-3.0-or-later
name:               mp-hcalc
version:            0.1.0.0
synopsis:           A certifying SMT core: DPLL SAT, Fourier-Motzkin linear arithmetic, DPLL(T).
license:            AGPL-3.0-or-later
build-type:         Simple

library
  exposed-modules:  MP.Hcalc.Sat
                    MP.Hcalc.Linear
                    MP.Hcalc.Smt
  hs-source-dirs:   src
  build-depends:    base >=4.20 && <4.21, containers >=0.7 && <0.8
  default-language: GHC2021

test-suite mp-hcalc-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:    base >=4.20 && <4.21, containers >=0.7 && <0.8, mp-check, mp-hcalc
  default-language: GHC2021
