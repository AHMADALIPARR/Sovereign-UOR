'# Poly64 dual oracle, Dex side

'Second, independent implementation of two-variable polynomial arithmetic
over Z/2^64 (Word64 wraps). The Scala kernel (src/main/scala/uor/kernel/Poly64.scala,
driven by dex/scala/Poly64Vectors.scala) prints the same lines; CI diffs them.
Polynomials here are dense coefficient tables, not sorted sparse term lists,
so the two sides share no code and no data layout.

'## SplitMix64

'`rem` on Word64 is a signed remainder in this Dex version (checked:
`rem` of 0xdc336acab085b9ce by 4 gives 0xfffffffffffffffe), so the unsigned
remainder is built from 32-bit halves, where signed and unsigned agree.
`.>>.` on Word64 is a logical shift (checked: 0xffffffff00000000 .>>. 30
gives 0x3fffffffc).

def w64(hi:Word64, lo:Word64) -> Word64 = (hi .<<. 32) .|. lo

# Unsigned remainder for 0 < m < 2^31.
def urem(x:Word64, m:Word64) -> Word64 =
  hi = x .>>. 32
  lo = x .&. 4294967295
  rem(rem(hi, m) * rem(w64(1, 0), m) + rem(lo, m), m)

gamma = w64(2654435769, 2135587861)
mix1 = w64(3210233709, 484763065)
mix2 = w64(2496678331, 321982955)
seed : Word64 = 24301

def mix(s:Word64) -> Word64 =
  z1 = (s .^. (s .>>. 30)) * mix1
  z2 = (z1 .^. (z1 .>>. 27)) * mix2
  z2 .^. (z2 .>>. 31)

# Output number k (0-based) of the generator started at seed.
def draw(k:Word64) -> Word64 = mix(seed + (k + 1) * gamma)

def ow(i:n) -> Word64 given (n|Ix) = n_to_w64(ordinal(i))

'## Formatting

def hex_digit(d:Word64) -> Char =
  if d < 10
    then internal_cast(to=Word8, d + 48)
    else internal_cast(to=Word8, d + 87)

def hex16(x:Word64) -> String =
  to_list for i:(Fin 16).
    hex_digit((x .>>. (60 - 4 * n_to_i(ordinal(i)))) .&. 15)

def term(a:Nat, b:Nat, c:Word64) -> String =
  " " <> show(a) <> "," <> show(b) <> ":" <> hex16(c)

def terms(t:n=>n=>Word64) -> String given (n|Ix) =
  empty : String = mempty
  s = concat for a:n. concat for b:n.
    if t[a][b] == 0
      then empty
      else term(ordinal(a), ordinal(b), t[a][b])
  if list_length(s) == 0 then " 0" else s

'## Dense polynomials

Poly4 = Fin 4 => Fin 4 => Word64
Poly7 = Fin 7 => Fin 7 => Word64

# A random polynomial starting at draw number base:
# nterms = 1 + w mod 4, then per term e0 = w mod 4, e1 = w mod 4, coeff = w.
# Returns the number of draws used and the dense coefficient table.
def poly_at(base:Word64) -> (Word64, Poly4) =
  n = urem(draw(base), 4) + 1
  e0 = for t:(Fin 4). urem(draw(base + ow(t) * 3 + 1), 4)
  e1 = for t:(Fin 4). urem(draw(base + ow(t) * 3 + 2), 4)
  c = for t:(Fin 4). draw(base + ow(t) * 3 + 3)
  dense = for i:(Fin 4). for j:(Fin 4).
    sum for t:(Fin 4).
      used = ow(t) < n
      here = (e0[t] == ow(i)) && (e1[t] == ow(j))
      if used && here then c[t] else 0
  (n * 3 + 1, dense)

def poly_add(p:Poly4, q:Poly4) -> Poly4 = for i j. p[i][j] + q[i][j]

def poly_mul(p:Poly4, q:Poly4) -> Poly7 =
  for a:(Fin 7). for b:(Fin 7).
    sum for i:(Fin 4). sum for j:(Fin 4). sum for k:(Fin 4). sum for l:(Fin 4).
      hit = ((ordinal(i) + ordinal(k)) == ordinal(a)) && ((ordinal(j) + ordinal(l)) == ordinal(b))
      if hit then p[i][j] * q[k][l] else 0

def power(x:Word64, e:Nat) -> Word64 =
  prod for t:(Fin 7). if ordinal(t) < e then x else 1

def poly_eval(t:Poly7, x0:Word64, x1:Word64) -> Word64 =
  sum for a:(Fin 7). sum for b:(Fin 7).
    t[a][b] * power(x0, ordinal(a)) * power(x1, ordinal(b))

'## Driver: 200 cases

unsafe_io \.
  with_state (0 :: Word64) \pos.
    for c:(Fin 200).
      base = get(pos)
      (np, p) = poly_at(base)
      (nq, q) = poly_at(base + np)
      x0 = draw(base + np + nq)
      x1 = draw(base + np + nq + 1)
      pos := base + np + nq + 2
      prefix = "case " <> show(ordinal(c))
      pq = poly_mul(p, q)
      print(prefix <> " add" <> terms(poly_add(p, q)))
      print(prefix <> " mul" <> terms(pq))
      print(prefix <> " eval " <> hex16(poly_eval(pq, x0, x1)))
  ()
